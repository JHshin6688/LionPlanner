SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5
SERPER_API_KEY=your_serper_api_key
JINA_API_KEY=your_jina_api_key_optional

# Used to embed syllabus_summary (src/pipeline/embeddings.py) for RAG retrieval.
VOYAGE_API_KEY=your_voyage_api_key
VOYAGE_EMBEDDING_MODEL=voyage-3.5

# Ask LionPlanner (multi-agent RAG) — src/agents/, src/api/
# Reuses ANTHROPIC_API_KEY above. Optional override if the agent graph should
# use a different model than the analyzer pipeline (defaults to ANTHROPIC_MODEL).
ANTHROPIC_AGENT_MODEL=claude-sonnet-4-5
FIRECRAWL_API_KEY=your_firecrawl_api_key_optional
