SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5
SERPER_API_KEY=your_serper_api_key
JINA_API_KEY=your_jina_api_key_optional

# Used to embed syllabus_summary (src/pipeline/embeddings.py) for RAG retrieval.
VOYAGE_API_KEY=your_voyage_api_key
VOYAGE_EMBEDDING_MODEL=voyage-3.5

# Ask LionPlanner (multi-agent RAG) — src/agents/, src/api/
# Reuses ANTHROPIC_API_KEY above. Optional override if the agent graph should
# use a different model than the analyzer pipeline (defaults to ANTHROPIC_MODEL).
ANTHROPIC_AGENT_MODEL=claude-sonnet-4-5
# analyze_query is a single cheap classification call — defaults to Haiku regardless of ANTHROPIC_AGENT_MODEL.
ANTHROPIC_ROUTER_MODEL=claude-haiku-4-5-20251001
FIRECRAWL_API_KEY=your_firecrawl_api_key_optional

# Comma-separated list of origins allowed to call src/api/main.py (CORS).
# Set to the deployed Vercel frontend URL in production, e.g.
# FRONTEND_ORIGINS=https://lionplanner-front.vercel.app,http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173

# LangSmith tracing — set these and every graph.invoke() in src/api/main.py is
# traced automatically (node-by-node, incl. the recommend_course agent's tool
# calls). No code changes needed beyond setting these; get the key from
# smith.langchain.com.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=lionplanner